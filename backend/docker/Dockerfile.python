# BenchMax Python sandbox — for code benchmarks
# Required by: HumanEval, BigCodeBench (full), BigCodeBench-Hard, LiveBench (coding)
# BigCodeBench: 71.8% of samples need third-party packages, this install covers 100% of them
# (except tensorflow — ~500MB for 3 samples, bad ROI)
FROM python:3.11-slim

# System dependencies for opencv, pytesseract, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    pandas \
    numpy \
    matplotlib \
    scikit-learn \
    scipy \
    seaborn \
    requests \
    nltk \
    beautifulsoup4 \
    python-dateutil \
    pytz \
    Pillow \
    statsmodels \
    sympy \
    regex \
    lxml \
    psutil \
    cryptography \
    rsa \
    flask \
    openpyxl \
    wordcloud \
    textblob \
    xmltodict \
    geopy \
    faker \
    pyyaml \
    chardet \
    opencv-python \
    django \
    flask-mail \
    folium \
    xlwt \
    mechanize \
    python-docx \
    texttable \
    wikipedia \
    flask-restful \
    flask-login \
    flask-wtf \
    holidays \
    scikit-image \
    geopandas \
    shapely \
    librosa \
    soundfile \
    python-http-client \
    sendgrid \
    blake3 \
    natsort \
    keras \
    prettytable \
    pycryptodome \
    pyquery \
    gensim \
    python-Levenshtein \
    wordninja \
    pytesseract \
    && rm -rf /tmp/*

# Set matplotlib to headless backend to avoid display errors
ENV MPLBACKEND=Agg

WORKDIR /workspace

CMD ["python", "--version"]
