# BenchMax Python sandbox — max coverage variant (~1GB, ~99% of BigCodeBench)
# For maximum benchmark compatibility at the cost of image size.
# The standard Dockerfile.python covers ~96% at ~400MB.
FROM python:3.11-slim

# Full install: covers ~99% of BigCodeBench samples including edge cases
RUN pip install --no-cache-dir \
    pandas numpy matplotlib scikit-learn scipy seaborn \
    requests nltk beautifulsoup4 pytz opencv-python python-dateutil \
    statsmodels rsa flask pillow psutil regex django cryptography \
    lxml wordcloud openpyxl python-docx \
    folium flask-login flask-wtf flask-mail \
    shapely geopandas librosa soundfile \
    keras sympy geopy texttable textblob \
    xmltodict faker holidays scikit-image \
    gensim python-devtools pytesseract chardet \
    && rm -rf /tmp/*

# Install system-level dependencies for packages that need them
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

ENV MPLBACKEND=Agg
ENV PYTHONUNBUFFERED=1

RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /workspace

WORKDIR /workspace

USER appuser

CMD ["python", "--version"]
